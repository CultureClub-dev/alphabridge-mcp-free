 "content": "<!-- wp:media-text {\"align\":\"full\",\"mediaPosition\":\"right\",\"mediaLink\":\"https://example.test/wp-content/themes/twentytwentytwo/assets/images/bird-on-black.jpg\",\"mediaType\":\"image\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|background\"}}}},\"backgroundColor\":\"foreground\",\"textColor\":\"background\"} -->\n\t\t\t\t<div class=\"wp-block-media-text alignfull has-media-on-the-right is-stacked-on-mobile has-background-color has-foreground-background-color has-text-color has-background has-link-color\"><figure class=\"wp-block-media-text__media\"><img src=\"https://example.test/wp-content/themes/twentytwentytwo/assets/images/bird-on-black.jpg\" alt=\"An image of a bird flying\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:spacer {\"height\":32} -->\n\t\t\t\t\t<div style=\"height:32px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t\t<!-- /wp:spacer -->\n\t\t\t\t\t<!-- wp:site-logo {\"width\":60} /-->\n\n\t\t\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"min(8rem, 5vw)\",\"top\":\"min(20rem, 20vw)\"}}}} -->\n\t\t\t\t\t<div class=\"wp-block-group\" style=\"padding-top:min(20rem, 20vw);padding-right:min(8rem, 5vw)\"><!-- wp:heading {\"style\":{\"typography\":{\"fontWeight\":\"300\",\"lineHeight\":\"1.115\",\"fontSize\":\"clamp(3rem, 6vw, 4.5rem)\"}}} -->\n\t\t\t\t\t<h2 style=\"font-size:clamp(3rem, 6vw, 4.5rem);font-weight:300;line-height:1.115\"><em>Emery<br>Driscoll</em></h2>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"lineHeight\":\"1.6\"}}} -->\n\t\t\t\t\t<p style=\"line-height:1.6\">Oh hello. My name’s Emery, and you’ve found your way to my website. I’m an avid bird watcher, and I also broadcast my own radio show on Tuesday evenings at 11PM EDT.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t\t\t<!-- wp:spacer {\"height\":40} -->\n\t\t\t\t\t<div style=\"height:40px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t\t<!-- /wp:spacer -->\n\n\t\t\t\t\t<!-- wp:social-links {\"iconColor\":\"background\",\"iconColorValue\":\"var(--wp--preset--color--foreground)\",\"iconBackgroundColor\":\"foreground\",\"iconBackgroundColorValue\":\"var(--wp--preset--color--background)\"} -->\n\t\t\t\t\t<ul class=\"wp-block-social-links has-icon-color has-icon-background-color\"><!-- wp:social-link {\"url\":\"#\",\"service\":\"wordpress\"} /-->\n\n\t\t\t\t\t<!-- wp:social-link {\"url\":\"#\",\"service\":\"twitter\"} /-->\n\n\t\t\t\t\t<!-- wp:social-link {\"url\":\"#\",\"service\":\"instagram\"} /--></ul>\n\t\t\t\t\t<!-- /wp:social-links --></div>\n\t\t\t\t\t<!-- /wp:group --></div>\n\n\t\t\t\t\t<!-- wp:spacer {\"height\":32} -->\n\t\t\t\t\t<div style=\"height:32px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t\t<!-- /wp:spacer --></div>\n\t\t\t\t\t<!-- /wp:media-text -->"
