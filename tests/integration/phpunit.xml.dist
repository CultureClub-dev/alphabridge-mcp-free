<?xml version="1.0" encoding="UTF-8"?>
<!-- The integration suite: two WordPress 7.1.3 sites on MariaDB (README.md). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="integration">
            <directory>.</directory>
        </testsuite>
    </testsuites>
    <!-- After each test the time limit of the command line again
         (support/class-it-time-limit.php, required by bootstrap.php). -->
    <extensions>
        <bootstrap class="AB_MCP_IT_Time_Limit"/>
    </extensions>
</phpunit>
