# German translations of every text of AlphaBridge MCP that a person reads:
# the settings page, the consent screen, the notices, the refusals and errors
# an assistant passes on, and the plugin's description in the plugin list.
# Tool and parameter descriptions and the server instructions are written for
# the assistant and stay English.
# Bundled with the plugin; a language pack from translate.wordpress.org takes
# precedence for every string it translates (AB_MCP_Plugin::load_bundled_translations()).
# This file is distributed under the same license as the AlphaBridge MCP plugin.
msgid ""
msgstr ""
"Project-Id-Version: AlphaBridge MCP 4.5.1\n"
"PO-Revision-Date: 2026-10-02 20:00+0200\n"
"Last-Translator: AlphaBridge MCP\n"
"Language-Team: German\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: alphabridge-mcp\n"

#, php-format
msgid "\"%1$s\" falls where the clocks go back in the site's timezone, so its local time occurs twice. WordPress schedules posts by local time and would read it as \"%2$s\". Choose a time outside that stretch, or give that offset."
msgstr "„%1$s“ fällt in die Zeit, in der in der Zeitzone der Website die Uhren zurückgestellt werden, diese Ortszeit gibt es also zweimal. WordPress plant Beiträge nach Ortszeit und würde sie als „%2$s“ lesen. Eine Zeit außerhalb dieser Spanne wählen oder diesen Versatz mit angeben."

#, php-format
msgid "\"%s\" does not exist in the site's timezone: the clocks skip over it. Choose another time."
msgstr "„%s“ gibt es in der Zeitzone der Website nicht: Die Uhren springen darüber hinweg. Eine andere Zeit wählen."

#, php-format
msgid "\"%s\" exceeds the 8 MB size limit (send less per call; a large file is fetched from a public address with wp_upload_media_from_url)"
msgstr "„%s“ überschreitet die Grenze von 8 MB (weniger pro Aufruf senden; eine große Datei wird mit wp_upload_media_from_url von einer öffentlichen Adresse geholt)"

#, php-format
msgid "\"%s\" falls outside the years WordPress can store (1 to 9999). Choose a date within them."
msgstr "„%s“ liegt außerhalb der Jahre, die WordPress speichern kann (1 bis 9999). Ein Datum in diesem Bereich wählen."

#, php-format
msgid "\"%s\" has too many items (max 2000; split them across several calls)"
msgstr "„%s“ hat zu viele Einträge (höchstens 2000; auf mehrere Aufrufe verteilen)"

#, php-format
msgid "\"%s\" must be a number"
msgstr "„%s“ muss eine Zahl sein"

#, php-format
msgid "\"%s\" must be a string"
msgstr "„%s“ muss eine Zeichenkette sein"

#, php-format
msgid "\"%s\" must be an array/object"
msgstr "„%s“ muss ein Array oder Objekt sein"

msgid "$49/year"
msgstr "$49/Jahr"

msgid "$9/month"
msgstr "$9/Monat"

#, php-format
msgid "%1$s keeps this page in its own database tables, which this plugin's page builder tools do not read; change it in the %2$s editor."
msgstr "%1$s speichert diese Seite in eigenen Datenbanktabellen, die die Page-Builder-Werkzeuge dieses Plugins nicht lesen; die Seite im Editor von %2$s ändern."

#, php-format
msgid "%1$s of %2$s on"
msgstr "%1$s von %2$s an"

#, php-format
msgid "%1$s of %2$s tools can run with write access off"
msgstr "%1$s von %2$s Werkzeugen laufen auch bei ausgeschalteten Schreibrechten"

#, php-format
msgid "%1$s of %2$s tools on"
msgstr "%1$s von %2$s Werkzeugen an"

#, php-format
msgid "%1$s wants to connect to %2$s"
msgstr "%1$s möchte sich mit %2$s verbinden"

