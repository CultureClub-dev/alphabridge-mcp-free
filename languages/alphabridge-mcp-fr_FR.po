# French translations of every text of AlphaBridge MCP that a person reads:
# the settings page, the consent screen, the notices, the refusals and errors
# an assistant passes on, and the plugin's description in the plugin list.
# Tool and parameter descriptions and the server instructions are written for
# the assistant and stay English.
# Bundled with the plugin; a language pack from translate.wordpress.org takes
# precedence for every string it translates (AB_MCP_Plugin::load_bundled_translations()).
# This file is distributed under the same license as the AlphaBridge MCP plugin.
msgid ""
msgstr ""
"Project-Id-Version: AlphaBridge MCP 4.6.7\n"
"PO-Revision-Date: 2026-10-21 12:00+0200\n"
"Last-Translator: AlphaBridge MCP\n"
"Language-Team: French\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: alphabridge-mcp\n"

msgid "As an affiliate you profit from every Pro and Agency purchase made through your link."
msgstr "En tant qu'affilié, vous profitez de chaque achat Pro et Agency effectué via votre lien."

msgid "Recommend AlphaBridge and profit."
msgstr "Recommandez AlphaBridge et profitez-en."

msgid "Your account cannot delete this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Votre compte ne peut pas supprimer ce commentaire précis. Connectez-vous avec un compte qui peut le modifier, par exemple celui d'un éditeur ou d'un administrateur."

msgid "Your account cannot delete this specific term. Connect with an account that may delete it, such as an editor or an administrator."
msgstr "Votre compte ne peut pas supprimer ce terme précis. Connectez-vous avec un compte qui peut le supprimer, par exemple celui d'un éditeur ou d'un administrateur."

msgid "Your account cannot edit this specific term. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Votre compte ne peut pas modifier ce terme précis. Connectez-vous avec un compte qui peut le modifier, par exemple celui d'un éditeur ou d'un administrateur."

msgid "Your account cannot moderate this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Votre compte ne peut pas modérer ce commentaire précis. Connectez-vous avec un compte qui peut le modifier, par exemple celui d'un éditeur ou d'un administrateur."

msgid "Your account cannot reply under this specific post: a reply from here takes the right to edit the post, as in wp-admin. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Votre compte ne peut pas répondre sous cet article précis : depuis ici, une réponse demande le droit de modifier l'article, comme dans wp-admin. Connectez-vous avec un compte qui peut le modifier, par exemple celui d'un éditeur ou d'un administrateur."

#, php-format
msgid "\"%1$s\" falls where the clocks go back in the site's timezone, so its local time occurs twice. WordPress schedules posts by local time and would read it as \"%2$s\". Choose a time outside that stretch, or give that offset."
msgstr "« %1$s » tombe au moment où les horloges reculent dans le fuseau horaire du site, cette heure locale existe donc deux fois. WordPress planifie les articles selon l'heure locale et la lirait comme « %2$s ». Choisissez une heure en dehors de cette plage, ou indiquez ce décalage."

#, php-format
msgid "\"%s\" does not exist in the site's timezone: the clocks skip over it. Choose another time."
msgstr "« %s » n'existe pas dans le fuseau horaire du site : les horloges sautent cette heure. Choisissez une autre heure."

#, php-format
msgid "\"%s\" exceeds the 8 MB size limit (send less per call; a large file is fetched from a public address with wp_upload_media_from_url)"
msgstr "« %s » dépasse la limite de 8 Mo (envoyez moins par appel ; un gros fichier se récupère depuis une adresse publique avec wp_upload_media_from_url)"

#, php-format
msgid "\"%s\" falls outside the years WordPress can store (1 to 9999). Choose a date within them."
msgstr "« %s » se situe en dehors des années que WordPress peut enregistrer (1 à 9999). Choisissez une date dans cet intervalle."

#, php-format
msgid "\"%s\" has too many items (max 2000; split them across several calls)"
msgstr "« %s » contient trop d'éléments (2000 au maximum ; répartissez-les sur plusieurs appels)"

#, php-format
msgid "\"%s\" must be a number"
msgstr "« %s » doit être un nombre"

#, php-format
msgid "\"%s\" must be a string"
msgstr "« %s » doit être une chaîne de caractères"

#, php-format
msgid "\"%s\" must be an array/object"
msgstr "« %s » doit être un tableau ou un objet"

msgid "$49/year"
msgstr "$49/an"

msgid "$9/month"
msgstr "$9/mois"

#, php-format
msgid "%1$s keeps this page in its own database tables, which this plugin's page builder tools do not read; change it in the %2$s editor."
msgstr "%1$s conserve cette page dans ses propres tables de base de données, que les outils de constructeurs de pages de cette extension ne lisent pas ; modifiez-la dans l'éditeur de %2$s."

#, php-format
msgid "%1$s of %2$s on"
msgstr "%1$s sur %2$s activés"

#, php-format
msgid "%1$s of %2$s tools can run with write access off"
msgstr "%1$s outils sur %2$s peuvent s'exécuter avec l'accès en écriture désactivé"

#, php-format
msgid "%1$s of %2$s tools on"
msgstr "%1$s outils sur %2$s activés"

#, php-format
msgid "%1$s wants to connect to %2$s"
msgstr "%1$s souhaite se connecter à %2$s"

