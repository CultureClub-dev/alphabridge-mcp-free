msgstr "Abrir o diretório do Claude"

msgid "Open Cursor’s MCP settings (for all projects: ~/.cursor/mcp.json), paste, save and reload the servers."
msgstr "Abra as definições MCP do Cursor (para todos os projetos: ~/.cursor/mcp.json), cole, guarde e recarregue os servidores."

msgid "Open AlphaBridge → AI Connection"
msgstr "Abrir AlphaBridge → Ligação IA"

