# Italian translations of every text of AlphaBridge MCP that a person reads:
# the settings page, the consent screen, the notices, the refusals and errors
# an assistant passes on, and the plugin's description in the plugin list.
# Tool and parameter descriptions and the server instructions are written for
# the assistant and stay English.
# Bundled with the plugin; a language pack from translate.wordpress.org takes
# precedence for every string it translates (AB_MCP_Plugin::load_bundled_translations()).
# This file is distributed under the same license as the AlphaBridge MCP plugin.
msgid ""
msgstr ""
"Project-Id-Version: AlphaBridge MCP 4.6.7\n"
"PO-Revision-Date: 2026-10-21 12:00+0200\n"
"Last-Translator: AlphaBridge MCP\n"
"Language-Team: Italian\n"
"Language: it_IT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: alphabridge-mcp\n"

msgid "As an affiliate you profit from every Pro and Agency purchase made through your link."
msgstr "Come affiliato guadagni su ogni acquisto di Pro e Agency fatto tramite il tuo link."

msgid "Recommend AlphaBridge and profit."
msgstr "Consiglia AlphaBridge e guadagnaci."

msgid "Your account cannot delete this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Il tuo account non può eliminare proprio questo commento. Collegati con un account che può modificarlo, ad esempio quello di un editore o di un amministratore."

msgid "Your account cannot delete this specific term. Connect with an account that may delete it, such as an editor or an administrator."
msgstr "Il tuo account non può eliminare proprio questo termine. Collegati con un account che può eliminarlo, ad esempio quello di un editore o di un amministratore."

msgid "Your account cannot edit this specific term. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Il tuo account non può modificare proprio questo termine. Collegati con un account che può modificarlo, ad esempio quello di un editore o di un amministratore."

msgid "Your account cannot moderate this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Il tuo account non può moderare proprio questo commento. Collegati con un account che può modificarlo, ad esempio quello di un editore o di un amministratore."

msgid "Your account cannot reply under this specific post: a reply from here takes the right to edit the post, as in wp-admin. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Il tuo account non può rispondere sotto proprio questo articolo: da qui una risposta richiede il permesso di modificare l'articolo, come in wp-admin. Collegati con un account che può modificarlo, ad esempio quello di un editore o di un amministratore."

#, php-format
msgid "\"%1$s\" falls where the clocks go back in the site's timezone, so its local time occurs twice. WordPress schedules posts by local time and would read it as \"%2$s\". Choose a time outside that stretch, or give that offset."
msgstr "“%1$s” cade nel periodo in cui, nel fuso orario del sito, gli orologi vengono spostati indietro, quindi quest'ora locale esiste due volte. WordPress programma gli articoli in base all'ora locale e la leggerebbe come “%2$s”. Scegli un orario al di fuori di quell'intervallo oppure indica anche quello scostamento."

#, php-format
msgid "\"%s\" does not exist in the site's timezone: the clocks skip over it. Choose another time."
msgstr "“%s” non esiste nel fuso orario del sito: gli orologi saltano quell'ora. Scegli un altro orario."

#, php-format
msgid "\"%s\" exceeds the 8 MB size limit (send less per call; a large file is fetched from a public address with wp_upload_media_from_url)"
msgstr "“%s” supera il limite di 8 MB (invia meno dati per chiamata; un file grande si recupera da un indirizzo pubblico con wp_upload_media_from_url)"

#, php-format
msgid "\"%s\" falls outside the years WordPress can store (1 to 9999). Choose a date within them."
msgstr "“%s” è fuori dagli anni che WordPress può salvare (da 1 a 9999). Scegli una data compresa in questo intervallo."

#, php-format
msgid "\"%s\" has too many items (max 2000; split them across several calls)"
msgstr "“%s” ha troppi elementi (max 2000; suddividili su più chiamate)"

#, php-format
msgid "\"%s\" must be a number"
msgstr "“%s” deve essere un numero"

#, php-format
msgid "\"%s\" must be a string"
msgstr "“%s” deve essere una stringa"

#, php-format
msgid "\"%s\" must be an array/object"
msgstr "“%s” deve essere un array o un oggetto"

msgid "$49/year"
msgstr "$49/anno"

msgid "$9/month"
msgstr "$9/mese"

#, php-format
msgid "%1$s keeps this page in its own database tables, which this plugin's page builder tools do not read; change it in the %2$s editor."
msgstr "%1$s conserva questa pagina in tabelle proprie del database, che gli strumenti per page builder di questo plugin non leggono; modificala nell'editor di %2$s."

#, php-format
msgid "%1$s of %2$s on"
msgstr "%1$s di %2$s attivi"

