"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: alphabridge-mcp\n"

msgid "As an affiliate you profit from every Pro and Agency purchase made through your link."
msgstr "Como afiliado, ganas con cada compra de Pro y Agency hecha a través de tu enlace."

msgid "Recommend AlphaBridge and profit."
msgstr "Recomienda AlphaBridge y sal ganando."

msgid "Your account cannot delete this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "La cuenta de esta conexión no puede borrar este comentario en concreto. Conecta la app con una cuenta que pueda editarlo, como la de un editor o un administrador."

msgid "Your account cannot delete this specific term. Connect with an account that may delete it, such as an editor or an administrator."
msgstr "La cuenta de esta conexión no puede borrar este término en concreto. Conecta la app con una cuenta que pueda borrarlo, como la de un editor o un administrador."

msgid "Your account cannot edit this specific term. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "La cuenta de esta conexión no puede editar este término en concreto. Conecta la app con una cuenta que pueda editarlo, como la de un editor o un administrador."

msgid "Your account cannot moderate this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "La cuenta de esta conexión no puede moderar este comentario en concreto. Conecta la app con una cuenta que pueda editarlo, como la de un editor o un administrador."

msgid "Your account cannot reply under this specific post: a reply from here takes the right to edit the post, as in wp-admin. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "La cuenta de esta conexión no puede responder bajo esta entrada en concreto: desde aquí, una respuesta requiere el permiso de editar la entrada, como en wp-admin. Conecta la app con una cuenta que pueda editarla, como la de un editor o un administrador."

#, php-format
msgid "\"%1$s\" falls where the clocks go back in the site's timezone, so its local time occurs twice. WordPress schedules posts by local time and would read it as \"%2$s\". Choose a time outside that stretch, or give that offset."
msgstr "«%1$s» cae en el intervalo en que, en la zona horaria del sitio, se atrasan los relojes, así que esa hora local se da dos veces. WordPress programa las entradas según la hora local y la interpretaría como «%2$s». Elige una hora fuera de ese intervalo o indica ese desfase."

#, php-format
msgid "\"%s\" does not exist in the site's timezone: the clocks skip over it. Choose another time."
msgstr "«%s» no existe en la zona horaria del sitio: los relojes se la saltan. Elige otra hora."

#, php-format
msgid "\"%s\" exceeds the 8 MB size limit (send less per call; a large file is fetched from a public address with wp_upload_media_from_url)"
msgstr "«%s» supera el límite de tamaño de 8 MB (envía menos en cada llamada; un archivo grande se obtiene desde una dirección pública con wp_upload_media_from_url)"

#, php-format
msgid "\"%s\" falls outside the years WordPress can store (1 to 9999). Choose a date within them."
msgstr "«%s» queda fuera de los años que WordPress puede guardar (del 1 al 9999). Elige una fecha dentro de ese intervalo."

#, php-format
msgid "\"%s\" has too many items (max 2000; split them across several calls)"
msgstr "«%s» tiene demasiados elementos (máximo 2000; repártelos en varias llamadas)"

#, php-format
msgid "\"%s\" must be a number"
msgstr "«%s» debe ser un número"

#, php-format
msgid "\"%s\" must be a string"
msgstr "«%s» debe ser una cadena de texto"

#, php-format
msgid "\"%s\" must be an array/object"
msgstr "«%s» debe ser un array o un objeto"

msgid "$49/year"
msgstr "$49/año"

msgid "$9/month"
msgstr "$9/mes"

#, php-format
msgid "%1$s keeps this page in its own database tables, which this plugin's page builder tools do not read; change it in the %2$s editor."
msgstr "%1$s guarda esta página en sus propias tablas de la base de datos, que las herramientas de constructores de páginas de este plugin no leen; cámbiala en el editor de %2$s."

