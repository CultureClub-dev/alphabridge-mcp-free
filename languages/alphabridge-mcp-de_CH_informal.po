# German translations of every text of AlphaBridge MCP that a person reads:
# the settings page, the consent screen, the notices, the refusals and errors
# an assistant passes on, and the plugin's description in the plugin list.
# Tool and parameter descriptions and the server instructions are written for
# the assistant and stay English.
# Bundled with the plugin; a language pack from translate.wordpress.org takes
# precedence for every string it translates (AB_MCP_Plugin::load_bundled_translations()).
# This file is distributed under the same license as the AlphaBridge MCP plugin.
msgid ""
msgstr ""
"Project-Id-Version: AlphaBridge MCP 4.6.3\n"
"PO-Revision-Date: 2026-10-21 12:00+0200\n"
"Last-Translator: AlphaBridge MCP\n"
"Language-Team: German\n"
"Language: de_CH_informal\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: alphabridge-mcp\n"

msgid "As an affiliate you profit from every Pro and Agency purchase made through your link."
msgstr "Als Affiliate profitierst du von jedem Pro- und Agency-Kauf über deinen Link."

msgid "Recommend AlphaBridge and profit."
msgstr "Weiterempfehlen und profitieren."

msgid "Your account cannot delete this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Das Konto dieser Verbindung darf genau diesen Kommentar nicht löschen. Dafür die App mit einem Konto verbinden, das ihn bearbeiten darf, etwa dem eines Redakteurs oder Administrators."

msgid "Your account cannot delete this specific term. Connect with an account that may delete it, such as an editor or an administrator."
msgstr "Das Konto dieser Verbindung darf genau diesen Begriff nicht löschen. Dafür die App mit einem Konto verbinden, das ihn löschen darf, etwa dem eines Redakteurs oder Administrators."

msgid "Your account cannot edit this specific term. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Das Konto dieser Verbindung darf genau diesen Begriff nicht bearbeiten. Dafür die App mit einem Konto verbinden, das ihn bearbeiten darf, etwa dem eines Redakteurs oder Administrators."

msgid "Your account cannot moderate this specific comment. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Das Konto dieser Verbindung darf genau diesen Kommentar nicht moderieren. Dafür die App mit einem Konto verbinden, das ihn bearbeiten darf, etwa dem eines Redakteurs oder Administrators."

msgid "Your account cannot reply under this specific post: a reply from here takes the right to edit the post, as in wp-admin. Connect with an account that may edit it, such as an editor or an administrator."
msgstr "Das Konto dieser Verbindung darf unter genau diesem Beitrag nicht antworten: Eine Antwort von hier aus setzt wie in wp-admin das Recht voraus, den Beitrag zu bearbeiten. Dafür die App mit einem Konto verbinden, das ihn bearbeiten darf, etwa dem eines Redakteurs oder Administrators."

#, php-format
msgid "\"%1$s\" falls where the clocks go back in the site's timezone, so its local time occurs twice. WordPress schedules posts by local time and would read it as \"%2$s\". Choose a time outside that stretch, or give that offset."
msgstr "«%1$s» fällt in die Zeit, in der in der Zeitzone der Website die Uhren zurückgestellt werden, diese Ortszeit gibt es also zweimal. WordPress plant Beiträge nach Ortszeit und würde sie als «%2$s» lesen. Eine Zeit ausserhalb dieser Spanne wählen oder diesen Versatz mit angeben."

#, php-format
msgid "\"%s\" does not exist in the site's timezone: the clocks skip over it. Choose another time."
msgstr "«%s» gibt es in der Zeitzone der Website nicht: Die Uhren springen darüber hinweg. Eine andere Zeit wählen."

#, php-format
msgid "\"%s\" exceeds the 8 MB size limit (send less per call; a large file is fetched from a public address with wp_upload_media_from_url)"
msgstr "«%s» überschreitet die Grenze von 8 MB (weniger pro Aufruf senden; eine grosse Datei wird mit wp_upload_media_from_url von einer öffentlichen Adresse geholt)"

#, php-format
msgid "\"%s\" falls outside the years WordPress can store (1 to 9999). Choose a date within them."
msgstr "«%s» liegt ausserhalb der Jahre, die WordPress speichern kann (1 bis 9999). Ein Datum in diesem Bereich wählen."

#, php-format
msgid "\"%s\" has too many items (max 2000; split them across several calls)"
msgstr "«%s» hat zu viele Einträge (höchstens 2000; auf mehrere Aufrufe verteilen)"

#, php-format
msgid "\"%s\" must be a number"
msgstr "«%s» muss eine Zahl sein"

#, php-format
msgid "\"%s\" must be a string"
msgstr "«%s» muss eine Zeichenkette sein"

#, php-format
msgid "\"%s\" must be an array/object"
msgstr "«%s» muss ein Array oder Objekt sein"

msgid "$49/year"
msgstr "$49/Jahr"

msgid "$9/month"
msgstr "$9/Monat"

#, php-format
msgid "%1$s keeps this page in its own database tables, which this plugin's page builder tools do not read; change it in the %2$s editor."
msgstr "%1$s speichert diese Seite in eigenen Datenbanktabellen, die die Page-Builder-Werkzeuge dieses Plugins nicht lesen; die Seite im Editor von %2$s ändern."

#, php-format
msgid "%1$s of %2$s on"
msgstr "%1$s von %2$s an"

#, php-format
msgid "%1$s of %2$s tools can run with write access off"
msgstr "%1$s von %2$s Werkzeugen laufen auch bei ausgeschalteten Schreibrechten"

